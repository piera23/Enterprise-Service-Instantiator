{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Attach al Container (F5)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "/app/backend"
        }
      ]
    },
    {
      "name": "Locale: Avvia Backend con Debugger",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "console": "integratedTerminal",
      "env": {
        "DEBUG_MODE": "true"
      }
    }
  ]
}
